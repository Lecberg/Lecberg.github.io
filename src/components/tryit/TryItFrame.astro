---
// Shared wrapper for the hands-on "Try it" panels on case-study pages.
interface Props {
  title: string;
  intro: string;
  source: string; // where the data came from, shown under the panel
}
const { title, intro, source } = Astro.props;
---

<section aria-labelledby="try-it" class="mt-12 lg:mt-16">
  <div class="flex items-center gap-2">
    <span class="rounded bg-accent-soft px-1.5 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wide text-accent">Try it</span>
    <h2 id="try-it" class="text-xl font-bold tracking-tight">{title}</h2>
  </div>
  <p class="mt-2 max-w-3xl text-muted">{intro}</p>
  <div class="mt-5 rounded-xl border border-line bg-surface p-4 sm:p-5 lg:p-6">
    <slot />
  </div>
  <p class="mt-2 max-w-3xl text-xs text-muted">{source}</p>
</section>
