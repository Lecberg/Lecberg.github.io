---
// A row of workflow steps joined by arrows.
// kind: "step" (plain), "ai" (an LLM step, highlighted), "human" (a person, dashed border).
interface Props {
  steps: { kind: "step" | "ai" | "human"; text: string }[];
  label?: string;
}
const { steps, label = "How it works, step by step" } = Astro.props;

const style = {
  step: "border-line bg-surface",
  ai: "border-accent bg-accent-soft font-semibold",
  human: "border-dashed border-muted/60 bg-surface",
};
---

<div>
  <ol aria-label={label} class="flex flex-col items-stretch gap-2 md:flex-row md:items-stretch md:gap-0">
    {steps.map((s, i) => (
      <li class="flex flex-col items-center md:flex-1 md:flex-row">
        <div class={`flex w-full items-center justify-center rounded-lg border px-3 py-2.5 text-center text-sm leading-snug md:h-full ${style[s.kind]}`}>
          {s.kind === "ai" && <span class="sr-only">LLM step: </span>}
          {s.kind === "human" && <span class="sr-only">Person: </span>}
          {s.text}
        </div>
        {i < steps.length - 1 && (
          <span aria-hidden="true" class="py-0.5 text-accent md:px-1.5 md:py-0">
            <span class="md:hidden">↓</span><span class="hidden md:inline">→</span>
          </span>
        )}
      </li>
    ))}
  </ol>
  <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted">
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-sm border border-accent bg-accent-soft"></span>LLM step</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-sm border border-dashed border-muted"></span>A person acts or checks</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-sm border border-line bg-surface"></span>Code step</span>
  </p>
</div>
