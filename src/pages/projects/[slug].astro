---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Flow from "../../components/Flow.astro";
import TpdmMap from "../../components/tryit/TpdmMap.astro";
import PppRun from "../../components/tryit/PppRun.astro";
import CareerPilotReplay from "../../components/tryit/CareerPilotReplay.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  prev: CollectionEntry<"projects"> | null;
  next: CollectionEntry<"projects"> | null;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={`${d.title} · Ryan Ma`} description={d.tagline}>
  <article class="wrap pt-10 sm:pt-14">
    <a href="/#projects" class="text-sm text-muted no-underline hover:text-ink">← All projects</a>

    <!-- Header strip -->
    <header class="mt-6 max-w-4xl">
      <p class="font-mono text-sm text-accent">{d.dates} · {d.role}</p>
      <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">{d.title}</h1>
      <p class="mt-3 text-lg text-muted lg:text-xl">{d.subtitle}</p>
      <ul class="mt-5 flex flex-wrap gap-1.5 lg:hidden" aria-label="Built with">
        {d.stack.map((t) => (
          <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">{t}</li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-3 text-sm font-medium">
        {d.links.demo && (
          <a href={d.links.demo} class="rounded-lg bg-accent px-4 py-2 text-accent-ink no-underline hover:opacity-90">{d.links.demoLabel ?? "Live demo"} ↗</a>
        )}
        <a href={d.links.code} class="rounded-lg border border-line px-4 py-2 text-ink no-underline hover:border-accent">Code on GitHub ↗</a>
      </div>
    </header>

    <a href={d.cover.src} class="mt-10 block overflow-hidden rounded-xl border border-line">
      <Image src={d.cover} alt={d.coverAlt} widths={[640, 1024, 1600, 2000]} sizes="(min-width: 1440px) 1360px, 100vw" class="w-full" loading="eager" />
    </a>

    <!-- Results -->
    <section aria-labelledby="results" class="mt-12">
      <h2 id="results" class="sr-only">Results</h2>
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
        {d.figures.map((f) => (
          <div class="flex flex-col-reverse bg-surface p-4 lg:p-6">
            <dt class="mt-1 text-xs text-muted lg:text-sm">{f.label}</dt>
            <dd class="text-2xl font-bold tracking-tight tabular-nums text-accent lg:text-3xl">{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Problem -->
    <section class="mt-12 lg:mt-16">
      <h2 class="text-xl font-bold tracking-tight">The problem</h2>
      <p class="mt-3 max-w-3xl text-lg">{d.problem}</p>
    </section>

    <!-- Flow -->
    <section class="mt-12 lg:mt-16">
      <h2 class="text-xl font-bold tracking-tight">How it works</h2>
      <div class="mt-5">
        <Flow steps={d.flow} />
      </div>
    </section>

    <!-- Hands-on panel -->
    {d.tryit === "tpdm" && <TpdmMap />}
    {d.tryit === "ppp" && <PppRun />}
    {d.tryit === "careerpilot" && <CareerPilotReplay />}

    <!-- Body: sticky sidebar + Markdown (What I built, Keeping it reliable, ...) -->
    <div class="mt-12 border-t border-line pt-10 lg:mt-16 lg:grid lg:grid-cols-12 lg:gap-12 lg:pt-14">
      <aside class="hidden lg:col-span-3 lg:block" aria-label="Project details">
        <div class="sticky top-20 space-y-6 text-sm">
          <dl class="space-y-3">
            <div>
              <dt class="text-xs text-muted">Dates</dt>
              <dd class="mt-0.5 font-medium">{d.dates}</dd>
            </div>
            <div>
              <dt class="text-xs text-muted">Role</dt>
              <dd class="mt-0.5 font-medium">{d.role}</dd>
            </div>
            <div>
              <dt class="text-xs text-muted">Built with</dt>
              <dd class="mt-1.5">
                <ul class="flex flex-wrap gap-1.5">
                  {d.stack.map((t) => (
                    <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">{t}</li>
                  ))}
                </ul>
              </dd>
            </div>
          </dl>
          {sections.length > 0 && (
            <nav aria-label="On this page" class="border-t border-line pt-5">
              <p class="text-xs text-muted">On this page</p>
              <ul class="mt-2 space-y-1.5">
                {sections.map((h) => (
                  <li><a href={`#${h.slug}`} class="text-ink no-underline hover:text-accent">{h.text}</a></li>
                ))}
                <li><a href="#screenshots" class="text-ink no-underline hover:text-accent">Screenshots</a></li>
              </ul>
            </nav>
          )}
          <div class="flex flex-col gap-1.5 border-t border-line pt-5 font-medium">
            {d.links.demo && <a href={d.links.demo} class="text-accent no-underline hover:underline">{d.links.demoLabel ?? "Live demo"} ↗</a>}
            <a href={d.links.code} class="text-accent no-underline hover:underline">Code on GitHub ↗</a>
          </div>
        </div>
      </aside>

      <div class="prose-case max-w-[70ch] lg:col-span-9">
        <Content />
      </div>
    </div>

    <!-- Screenshots -->
    <section id="screenshots" class="mt-12 scroll-mt-20 lg:mt-16">
      <h2 class="text-xl font-bold tracking-tight">Screenshots</h2>
      <p class="mt-1 text-sm text-muted">Select an image to open it at full size.</p>
      <div class="mt-5 grid gap-6 md:grid-cols-2">
        {d.gallery.map((g, i) => (
          <figure class="md:[&:last-child:nth-child(odd)]:col-span-2">
            <a href={g.src.src} class="flex items-center justify-center overflow-hidden rounded-xl border border-line bg-surface">
              <Image
                src={g.src}
                alt={g.alt}
                widths={[640, 1024, 1600]}
                sizes={i === d.gallery.length - 1 && i % 2 === 0 ? "(min-width: 1440px) 1360px, 100vw" : "(min-width: 768px) 50vw, 100vw"}
                class="max-h-[640px] w-auto"
              />
            </a>
            <figcaption class="mt-2 text-sm text-muted">{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Prev / next -->
    <nav aria-label="More projects" class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {prev ? (
        <a href={`/projects/${prev.id}/`} class="rounded-xl border border-line p-4 no-underline hover:border-accent">
          <span class="text-xs text-muted">← Previous</span>
          <span class="mt-1 block font-semibold text-ink">{prev.data.title}</span>
        </a>
      ) : <span class="hidden sm:block"></span>}
      {next && (
        <a href={`/projects/${next.id}/`} class="rounded-xl border border-line p-4 text-right no-underline hover:border-accent">
          <span class="text-xs text-muted">Next →</span>
          <span class="mt-1 block font-semibold text-ink">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</Base>
