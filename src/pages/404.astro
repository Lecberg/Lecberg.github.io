---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · Ryan Ma" description="This page does not exist.">
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">This page does not exist</h1>
    <p class="mt-3 text-muted">The link may be old or mistyped.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-accent-ink no-underline hover:opacity-90">Go to the home page</a>
  </section>
</Base>
